{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kolay Public Approval Process Calendar API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Calendar",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create an event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.kolayik.com/v2/event/create"
          },
          "docs": "Create an event"
        },
        {
          "info": {
            "name": "View an event",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.kolayik.com/v2/event/view/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "View an event"
        },
        {
          "info": {
            "name": "List events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.kolayik.com/v2/event/list",
            "params": [
              {
                "name": "search",
                "value": "Meeting",
                "type": "query"
              },
              {
                "name": "start",
                "value": "2022-01-01 00:00:00",
                "type": "query"
              },
              {
                "name": "end",
                "value": "2022-12-31 23:59:59",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "10",
                "type": "query"
              },
              {
                "name": "page",
                "value": "1",
                "type": "query"
              }
            ]
          },
          "docs": "List events"
        },
        {
          "info": {
            "name": "Update an event",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.kolayik.com/v2/event/update/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update an event"
        },
        {
          "info": {
            "name": "Delete an event",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.kolayik.com/v2/event/delete/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an event"
        }
      ]
    }
  ],
  "bundled": true
}