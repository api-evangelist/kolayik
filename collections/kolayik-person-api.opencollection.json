        {
          "info": {
            "name": "Terminate employment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.kolayik.com/v2/person/terminate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "* personId: id value of the person who will be terminated.\n* date: date of termination. This attribute can be set to a future date.\n* reasonCode: code of termination reason. Can take values between \"01\" and \"50\". Each code is connected to a specific reason text.\n* details: comments and details about the termination. (Optional)\n* replacementId: terminated person's ongoing approval processes and managees will be switched to this person. (Optional)"
        },
