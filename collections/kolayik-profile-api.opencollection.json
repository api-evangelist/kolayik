{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kolay Public Approval Process Profile API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Profile",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Me",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.kolayik.com/v2/profile/me"
          },
          "docs": "Get basic info about authenticated person"
        }
      ]
    }
  ],
  "bundled": true
}